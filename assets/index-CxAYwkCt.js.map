#include <fog_pars_fragment>

uniform sampler2D texture1;
uniform sampler2D textures[4];
uniform float opacity;

#define MAX_MODELS 2

uniform vec3 uModelPositions[MAX_MODELS];
uniform float uColorRadii[MAX_MODELS];
uniform float uColorIntensities[MAX_MODELS];

// uniform vec3 uModelPos;       // 1. The moving model's position
// uniform float uColorRadius;   // 2. The radius of the color effect
// uniform float uColorIntensity; // 3. The master intensity toggle

varying vec2 vUv;
varying vec2 cloudUV;
varying vec3 vColor;
varying vec3 vWorldPosition;  // 3. Receive the world position from the vertex shader

void main() {
  float contrast = 1.5;
  float brightness = 0.1;
  
  // Calculate the original full-color grass
  vec3 baseColor = texture2D(textures[0], vUv).rgb * contrast;
  baseColor = baseColor + vec3(brightness, brightness, brightness);
  baseColor = mix(baseColor, texture2D(textures[1], cloudUV).rgb, 0.4);
  
  // Apply the vertex colors (shadows/highlights from the blade height)
  vec3 fullColor = baseColor * vColor;

  // 4. Calculate the Grayscale equivalent using standard luminance weights
  float luminance = dot(fullColor, vec3(0.299, 0.587, 0.114));
  // float darknessFactor = 0.4; 
  // vec3 grayColor = vec3(luminance * darknessFactor);
  
  luminance = pow(luminance, 6.8); 
  vec3 grayColor = vec3(luminance);

  // 5. Calculate the distance from this pixel to the model (ignoring Y height)
  // float dist = distance(vWorldPosition.xz, uModelPos.xz);

  // 6. Create a smooth blend factor (1.0 inside the radius, 0.0 outside)
  // The 0.5 creates a soft faded edge. Change 0.5 to 0.9 for a sharper edge.
  // float colorFactor = 1.0 - smoothstep(uColorRadius * 0.9, uColorRadius, dist);

  //colorFactor *= uColorIntensity;


  // 3. Accumulate the color factor from all models
  float totalColorFactor = 0.0;

  for(int i = 0; i < MAX_MODELS; i++) {
    // Skip calculations if this model's halo is turned off
    if(uColorIntensities[i] <= 0.0) continue; 

    float dist = distance(vWorldPosition.xz, uModelPositions[i].xz);
    float factor = 1.0 - smoothstep(uColorRadii[i] * 0.5, uColorRadii[i], dist);
    
    factor *= uColorIntensities[i];
    
    // Merge this halo with the others (max prevents values from exceeding 1.0)
    totalColorFactor = max(totalColorFactor, factor); 
  }



  // 7. Mix the gray and colored grass based on the distance factor
  vec3 finalColor = mix(grayColor, fullColor, totalColorFactor);

  gl_FragColor.rgb = finalColor;
  gl_FragColor.a = opacity;

  // 2. Apply the fog color over the final pixel
  #include <fog_fragment>
}