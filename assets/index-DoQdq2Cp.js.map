export default "uniform float uTime;\nuniform vec3 uSpine[NUM_SEGMENTS]; // Array of spine points\n\n// --- Morph & Flatten Uniforms ---\nuniform float uProgress;          // 0.0 = full snake, 1.0 = standing man silhouette\nuniform vec3 uManPosition;        // World position for the man's base/feet\nuniform vec2 uManSize;            // vec2(width, height) of the standing man\nuniform float uAnchorY;           // 0.0 = bottom-anchored, 0.5 = center\nuniform float uRadius;            // Snake base radius\nuniform float uTransitionWiggle;  // Wave amplitude during morph\n\nvarying vec3 vNormal;\nvarying float vT;\nvarying vec2 vCylinderPos;\nvarying vec2 vSilhouetteUv;\nvarying float vProgress;\n\n// Helper to get a point on the spine curve\nvec3 getPoint(float t) {\n    float index = t * float(NUM_SEGMENTS - 1);\n    int i = int(index);\n    vec3 p0 = uSpine[i];\n    vec3 p1 = uSpine[min(i + 1, NUM_SEGMENTS - 1)];\n    float localT = fract(index);\n    return mix(p0, p1, localT);\n}\n\nvoid main() {\n    float t = position.z; // 0.0 (head) to 1.0 (tail)\n    vT = t;\n    vCylinderPos = position.xy;\n    vNormal = normal;\n    vProgress = uProgress;\n\n    // =========================================================\n    // 1. SNAKE STATE (3D Curving Tube along uSpine)\n    // =========================================================\n    vec3 snakeSpinePos = getPoint(t);\n    vec3 snakeSpineNext = getPoint(min(t + 0.01, 1.0));\n    vec3 snakeDir = snakeSpineNext - snakeSpinePos;\n    float dirLen = length(snakeDir);\n    snakeDir = dirLen > 0.0001 ? normalize(snakeDir) : vec3(0.0, 1.0, 0.0);\n\n    vec3 up = vec3(0.0, 1.0, 0.0);\n    if (abs(dot(up, snakeDir)) > 0.99) {\n        up = vec3(0.0, 0.0, 1.0);\n    }\n    vec3 right = normalize(cross(up, snakeDir));\n    up = cross(snakeDir, right);\n\n    // Head rounded snout (0.0 to 0.01)\n    float headShape = smoothstep(0.0, 0.01, t);\n    // Tail taper (0.7 to 1.0)\n    float tailShape = 1.0 - smoothstep(0.7, 1.0, t);\n    float snakeTaper = headShape * tailShape;\n    snakeTaper = max(0.1, snakeTaper);\n\n    // Hood widening\n    float hood = smoothstep(0.01, 0.1, t) * (1.0 - smoothstep(0.1, 0.15, t));\n    snakeTaper += hood * 0.5;\n\n    // Normal 3D cylinder offset\n    vec3 snakeOffset = (right * position.x + up * position.y) * snakeTaper;\n    vec3 snakeVertexPos = snakeSpinePos + snakeOffset;\n\n    // =========================================================\n    // 2. STANDING MAN SILHOUETTE STATE (Flat 2D Plane in XY)\n    // =========================================================\n    // t = 0.0 (head) -> top of man\n    // t = 1.0 (tail) -> feet of man\n    float manY = uManPosition.y + uManSize.y * ((1.0 - t) - uAnchorY);\n    vec3 manSpinePos = vec3(uManPosition.x, manY, uManPosition.z);\n\n    // Normalized horizontal cross-section coordinate in [-1.0, 1.0]\n    float currentRadius = max(uRadius, 0.0001);\n    float normX = clamp(position.x / currentRadius, -1.0, 1.0);\n\n    // Flat horizontal spread for the silhouette\n    float manHalfWidth = uManSize.x * 0.5;\n    vec3 manOffset = vec3(normX * manHalfWidth, 0.0, 0.0);\n    vec3 manVertexPos = manSpinePos + manOffset;\n\n    // UV mapping for sampling the silhouette image\n    // U: 0.0 (left) to 1.0 (right)\n    // V: 0.0 (feet) to 1.0 (head)\n    float u = normX * 0.5 + 0.5;\n    float v = 1.0 - t;\n    vSilhouetteUv = vec2(u, v);\n\n    // =========================================================\n    // 3. MORPH & REVERSIBLE INTERPOLATION\n    // =========================================================\n    // Staggered morph: Spine aligns first, followed by cross-section flattening\n    float spineMorph = smoothstep(0.0, 0.75, uProgress);\n    float flattenMorph = smoothstep(0.2, 1.0, uProgress);\n\n    // Living transformation wave that peaks midway and decays to 0 at both ends\n    float morphArc = sin(uProgress * 3.14159265);\n    float wave = sin(t * 14.0 - uTime * 6.0) * morphArc * uTransitionWiggle;\n    vec3 waveOffset = vec3(wave, sin(t * 10.0) * (wave * 0.25), 0.0);\n\n    // Blend spine trajectory & cross-section flattening\n    vec3 blendedSpine = mix(snakeSpinePos, manSpinePos, spineMorph);\n    vec3 blendedOffset = mix(snakeOffset, manOffset, flattenMorph);\n\n    vec3 finalPos = blendedSpine + blendedOffset + waveOffset;\n\n    gl_Position = projectionMatrix * modelViewMatrix * vec4(finalPos, 1.0);\n}\n"