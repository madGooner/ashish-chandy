#include <clipping_planes_pars_fragment>

uniform sampler2D uTexture1;
uniform sampler2D uTexture2;
uniform float uProgress;
uniform float uEdgeWidth;
uniform vec3 uColorLead;
uniform vec3 uColorTrail;
uniform float opacity;

varying vec2 vUv;

#define NOISE_TYPE_PERLIN 1
#define NOISE_TYPE_VALUE 2
#define NOISE_TYPE NOISE_TYPE_PERLIN

#define MOD3 vec3(.1031, .11369, .13787)

float hash31(vec3 p3)
{
    p3 = fract(p3 * MOD3);
    p3 += dot(p3, p3.yzx + 19.19);
    return -1.0 + 2.0 * fract((p3.x + p3.y) * p3.z);
}

vec3 hash33(vec3 p3)
{
    p3 = fract(p3 * MOD3);
    p3 += dot(p3, p3.yxz + 19.19);
    return -1.0 + 2.0 * fract(vec3((p3.x + p3.y) * p3.z, (p3.x + p3.z) * p3.y, (p3.y + p3.z) * p3.x));
}

// ========= Noise ===========
#if NOISE_TYPE == NOISE_TYPE_VALUE
float value_noise(vec3 p)
{
    vec3 pi = floor(p);
    vec3 pf = p - pi;
    
    vec3 w = pf * pf * (3.0 - 2.0 * pf);
    
    return mix(
        mix(
            mix(hash31(pi + vec3(0, 0, 0)), hash31(pi + vec3(1, 0, 0)), w.x),
            mix(hash31(pi + vec3(0, 0, 1)), hash31(pi + vec3(1, 0, 1)), w.x), 
            w.z),
        mix(
            mix(hash31(pi + vec3(0, 1, 0)), hash31(pi + vec3(1, 1, 0)), w.x),
            mix(hash31(pi + vec3(0, 1, 1)), hash31(pi + vec3(1, 1, 1)), w.x), 
            w.z),
        w.y);
}
#define noise(p) value_noise(p)
#else
float perlin_noise(vec3 p)
{
    vec3 pi = floor(p);
    vec3 pf = p - pi;
    
    vec3 w = pf * pf * (3.0 - 2.0 * pf);
    
    return mix(
        mix(
            mix(dot(pf - vec3(0, 0, 0), hash33(pi + vec3(0, 0, 0))), 
                dot(pf - vec3(1, 0, 0), hash33(pi + vec3(1, 0, 0))),
                w.x),
            mix(dot(pf - vec3(0, 0, 1), hash33(pi + vec3(0, 0, 1))), 
                dot(pf - vec3(1, 0, 1), hash33(pi + vec3(1, 0, 1))),
                w.x),
            w.z),
        mix(
            mix(dot(pf - vec3(0, 1, 0), hash33(pi + vec3(0, 1, 0))), 
                dot(pf - vec3(1, 1, 0), hash33(pi + vec3(1, 1, 0))),
                w.x),
            mix(dot(pf - vec3(0, 1, 1), hash33(pi + vec3(0, 1, 1))), 
                dot(pf - vec3(1, 1, 1), hash33(pi + vec3(1, 1, 1))),
                w.x),
            w.z),
        w.y);
}
#define noise(p) perlin_noise(p)
#endif

float fbm0(vec2 p)
{
    float d = 0.0;
    float m = 4.0;
    d += 0.5 * noise(p.xyy); p = m * p;
    d += 0.25 * noise(p.xyy); p = m * p;
    d += 0.125 * noise(p.xyy); p = m * p;
    d += 0.0625 * noise(p.xyy); p = m * p;
    return d;
}

float fbm1(vec2 p)
{
    float d = 0.0;
    float m = 1.5;
    d -= 0.5 * noise(p.xyy); p = m * p;
    d -= 0.25 * noise(p.xyy); p = m * p;
    d -= 0.125 * noise(p.xyy); p = m * p;
    d -= 0.0625 * noise(p.xyy); p = m * p;
    return d;
}

float FBM(vec2 p)
{
    float d = 0.0;
    p.xy -= 0.5;
    vec2 op = p;
    p *= 4.0;
    if (p.x < 10.0) {        
        float w = 1.0;
        d += w * noise(p.xyy); 
        
        p *= 4.0;
        w /= 8.0;
        mat2 m = mat2(1.6, 1.2, -1.2, 1.6); 
        d -= w * noise(p.xyy); p = m * p; w *= 0.5;
        d -= w * noise(p.xyy); p = m * p; w *= 0.5;
        d -= w * noise(p.xyy); p = m * p; w *= 0.5;
        d -= w * noise(p.xyy); p = m * p; w *= 0.5;
    }
    else {
        if (p.x < 0.0) {
            d = noise((p + vec2(0.5, 0.0)).xyy * 10.0);
        }
        else {
            d = fbm1(p * 2.0);
        }
        d = fbm1(p * 1.0);
    }
    
    d += 0.5;
    
    float x = clamp(length(op) / (0.5 * sqrt(2.0)), 0.0, 1.0);
    x = pow(x, 1.0);
    d *= x;
    
    d -= 0.5;

    return max(d, -0.5);
}

void main() {
    #include <clipping_planes_fragment>

    vec4 tex1 = texture2D(uTexture1, vUv);
    vec4 tex2 = texture2D(uTexture2, vUv);

    // Fast path for idle boundaries
    if (uProgress <= 0.0) {
        gl_FragColor = vec4(tex1.rgb, tex1.a * opacity);
        return;
    }
    if (uProgress >= 1.0) {
        gl_FragColor = vec4(tex2.rgb, tex2.a * opacity);
        return;
    }

    float heightmap = FBM(vUv) + 0.5;

    // t sweeps from -0.02 (fully tex1) to 1.25 (fully tex2)
    float t = mix(-0.02, 1.25, uProgress);
    float edgeWidth = uEdgeWidth;

    float erosion = smoothstep(t - edgeWidth, t, heightmap);

    // Burning ember edge
    float border = smoothstep(0.0, 0.1, erosion) - smoothstep(0.1, 1.0, erosion);
    vec3 bordercolor = mix(uColorLead, uColorTrail, smoothstep(0.9, 1.0, border));

    // Foreground is revealed where erosion has burned through
    vec3 col = mix(tex2.rgb, bordercolor * border, step(0.01, border));
    col = mix(col, tex1.rgb, erosion);

    float alpha = mix(tex2.a, tex1.a, erosion);
    alpha = max(alpha, border);

    gl_FragColor = vec4(col, alpha * opacity);
}

