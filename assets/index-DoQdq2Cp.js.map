#include <fog_pars_vertex>

varying vec2 vUv;
varying vec2 cloudUV;
varying vec3 vColor;
varying vec3 vWorldPosition; // 1. Add this new varying

uniform float iTime;

void main() {
  vUv = uv;
  cloudUV = uv;
  vColor = color;
  vec3 cpos = position;

  float waveSize = 10.0f * 10.;
  float tipDistance = 0.31f * 20.;
  float centerDistance = 0.1f * 20.;
  
  if (color.x > 0.6f) {
    cpos.x += sin((iTime / 500.) + (uv.x * waveSize)) * tipDistance;
  } else if (color.x > 0.0f) {
    cpos.x += sin((iTime / 500.) + (uv.x * waveSize)) * centerDistance;
  }

  // 2. Calculate world position and pass it to the fragment shader
  vec4 worldPos = modelMatrix * vec4(cpos, 1.0);
  vWorldPosition = worldPos.xyz;

  cloudUV.x += iTime / 20000.;
  cloudUV.y += iTime / 10000.;
  
  // vec4 mvPosition = projectionMatrix * modelViewMatrix * vec4(cpos, 1.0);
  // gl_Position = mvPosition;

  vec4 mvPosition = modelViewMatrix * vec4(cpos, 1.0);
  gl_Position = projectionMatrix * mvPosition;

  #include <fog_vertex>
}