precision mediump float;
varying vec2 vUv;
uniform sampler2D uTexture;
uniform vec2 uMouse;
uniform float uRadius;
uniform float uSmoothness;
uniform vec2 iResolution;

void main() {
    vec4 color = texture2D(uTexture, vUv);
    float gray = 0.2126 * color.r + 0.7152 * color.g + 0.0722 * color.b;
    vec4 grayColor = vec4(gray, gray, gray, color.a);

    // Aspect ratio correction so the circle is not distorted on non-square panels
    // vec2 aspect = vec2(iResolution.x / max(iResolution.y, 1.0), 1.0);
    // float dist = distance(vUv * aspect, uMouse * aspect);

    // float radius = uRadius;
    // float smoothness = uSmoothness > 0.0 ? uSmoothness : 0.05;

    // 1.0 inside radius (full color), 0.0 outside radius (grayscale).
    // If radius <= 0.0, mask is strictly 0.0 (full grayscale)
    // float mask = radius <= 0.0 ? 0.0 : smoothstep(radius, max(radius - smoothness, 0.0), dist);

    // Using uRadius as a global color intensity for tubelight flicker
    gl_FragColor = mix(grayColor, color, uRadius);
}

