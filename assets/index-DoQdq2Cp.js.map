uniform vec3 uColor;
uniform float uProgress;
uniform sampler2D uSilhouetteTexture;
uniform float uHasSilhouette;     // 1.0 if texture loaded, 0.0 for fallback procedural silhouette
uniform float uIsAlpha;           // 1.0 for transparent PNG, 0.0 for dark silhouette on white background
uniform float uSilhouetteCutoff;  // Alpha discard threshold (e.g. 0.1 or threshold/255)

varying vec3 vNormal;
varying float vT;
varying vec2 vCylinderPos;
varying vec2 vSilhouetteUv;
varying float vProgress;

void main() {
    // =========================================================
    // 1. SNAKE HEAD EYES & 3D DIFFUSE SHADING
    // =========================================================
    vec2 eyeCenterL = vec2(-8.0, 5.0);
    vec2 eyeCenterR = vec2(8.0, 5.0);
    vec2 eyeRadii = vec2(3.5, 2.5);

    float eyeTStart = 0.02;
    float eyeTEnd = 0.05;
    float tCheck = smoothstep(eyeTStart, eyeTEnd, vT) * (1.0 - smoothstep(eyeTEnd, eyeTEnd + 0.01, vT));

    float distL = length((vCylinderPos - eyeCenterL) / eyeRadii);
    float distR = length((vCylinderPos - eyeCenterR) / eyeRadii);

    float eyeMask = (1.0 - smoothstep(0.95, 1.0, distL)) + 
                    (1.0 - smoothstep(0.95, 1.0, distR));
    eyeMask *= tCheck;

    // Fade eyes out during morph
    eyeMask *= (1.0 - smoothstep(0.0, 0.25, vProgress));

    // Base Snake Color with directional lighting
    vec3 lightDir = normalize(vec3(0.5, 1.0, 0.5));
    float diff = max(dot(vNormal, lightDir), 0.2);
    float lightingFactor = mix(diff, 1.0, smoothstep(0.1, 0.7, vProgress));
    vec3 baseColor = uColor * lightingFactor;
    vec3 currentSnakeColor = mix(baseColor, vec3(1.0, 1.0, 1.0), eyeMask);

    // =========================================================
    // 2. SILHOUETTE SAMPLING (Image Texture or Procedural Fallback)
    // =========================================================
    float silhouetteAlpha = 0.0;

    if (uHasSilhouette > 0.5) {
        if (vSilhouetteUv.x >= 0.0 && vSilhouetteUv.x <= 1.0 && vSilhouetteUv.y >= 0.0 && vSilhouetteUv.y <= 1.0) {
            vec4 tex = texture2D(uSilhouetteTexture, vSilhouetteUv);
            if (uIsAlpha > 0.5) {
                // Transparent PNG: silhouette presence is strictly defined by the alpha channel
                silhouetteAlpha = tex.a;
            } else {
                // Dark silhouette on white background: silhouette presence is defined by darkness
                float lum = dot(tex.rgb, vec3(0.299, 0.587, 0.114));
                silhouetteAlpha = clamp(1.0 - lum, 0.0, 1.0);
            }
        } else {
            silhouetteAlpha = 0.0;
        }
    } else {
        // High-quality procedural standing man silhouette fallback
        vec2 p = vSilhouetteUv;
        float px = (p.x - 0.5) * 2.0; // [-1.0, 1.0]
        float py = p.y;               // [0.0, 1.0]

        // Head (circular)
        float head = step(length(vec2(px * 1.35, py - 0.89)), 0.075);
        // Torso / shoulders
        float torso = step(abs(px), 0.22) * step(0.48, py) * step(py, 0.82);
        // Left & right legs
        float legL = step(abs(px - 0.10), 0.07) * step(0.0, py) * step(py, 0.48);
        float legR = step(abs(px + 0.10), 0.07) * step(0.0, py) * step(py, 0.48);
        // Left & right arms
        float armL = step(abs(px - 0.27), 0.05) * step(0.40, py) * step(py, 0.78);
        float armR = step(abs(px + 0.27), 0.05) * step(0.40, py) * step(py, 0.78);

        silhouetteAlpha = max(head, max(torso, max(max(legL, legR), max(armL, armR))));
    }

    // =========================================================
    // 3. MORPH TRANSPARENCY & DISCARD (Reversible)
    // =========================================================
    // Check if this fragment falls inside the silhouette
    bool isInsideSilhouette = silhouetteAlpha >= uSilhouetteCutoff;

    // For fragments that do NOT belong to the silhouette:
    // When vProgress = 0.0, they are 100% opaque snake body.
    // As vProgress moves to 1.0, they dissolve/fade to 0.0.
    float outsideAlpha = 1.0 - smoothstep(0.1, 0.85, vProgress);

    // Unconditional discard for anything outside the silhouette once fully morphed
    if (!isInsideSilhouette) {
        if (vProgress >= 0.85 || outsideAlpha < 0.01) {
            discard;
        }
    }

    // Fragment alpha
    float finalAlpha = isInsideSilhouette ? silhouetteAlpha : outsideAlpha;

    if (finalAlpha < 0.01) {
        discard;
    }

    // Blend to pure silhouette color
    vec3 finalColor = mix(currentSnakeColor, uColor, smoothstep(0.4, 0.9, vProgress));

    gl_FragColor = vec4(finalColor, finalAlpha);
}